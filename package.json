{
  "name": "pseudocode-to-python",
  "version": "1.0.0",
  "description": "PseudoPy - Automated Code Generation System with Central Backend Synchronization",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test tests/*.test.js && node test_operator_translation.js",
    "audit:mobile": "node scripts/mobile-audit.js",
    "build": "node scripts/build.js",
    "build:check": "node scripts/build.js --check",
    "docs:implementation": "node scripts/docs-implementation.js",
    "test:visual": "node scripts/qa/operator-after.cjs",
    "sop2": "node src/research/sop2-comparison.js",
    "prestart": "npm run build",
    "predev": "npm run build",
    "pretest": "npm run build:check"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
